{
  "name": "pi-neovim",
  "version": "0.1.0",
  "description": "pi.dev extension integrating Neovim — two-way editing, agent-modified files buffer, git-aware diffs, and bi-directional RPC. Supports tmux and embedded :terminal modes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettk/pi-neovim.git"
  },
  "homepage": "https://github.com/brettk/pi-neovim#readme",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx test/test-lua-full.ts && tsx test/test-lua-injection.ts",
    "test:lua": "tsx test/test-lua-full.ts",
    "test:injection": "tsx test/test-lua-injection.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/pi-nvim"
    ]
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.0",
    "typebox": "^1.3.8"
  }
}
